    // sync with each CS2 update (most recently for the 2026-07-08 update) - a more reliable
    // long-term source than a single-commit fork. Re-check that file if this ever goes stale again.
    "MovementUnlocker": {
        "lib": "server",
        "windows": "0F 86 AF ? ? ? 0F 57 C0 0F 2E C2",
        "linux":   "0F 87 ? ? ? ? F3 0F 10 25 ? ? ? ? F3 0F 11 A5 ? ? ? ? 48 89 DE"
    }
