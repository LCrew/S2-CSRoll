{
    // NOPs the conditional jump found by the "MovementUnlocker" signature above, removing CS2's
    // native landing-speed-cap check entirely (server-wide) for as long as GameModifierBhop is
    // active. Reversible via Core.GameData.RevertPatch, unlike the upstream reference plugin which
    // only ever applies it once at Load() and never reverts.
    "MovementUnlocker": {
        "signature": "MovementUnlocker",
        "windows": "E9 B0 00 00 00 90",
        "linux":   "90 90 90 90 90 90"
    }
}